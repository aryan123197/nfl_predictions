# Copy to .env and adjust. For zero-setup local dev, just leave
# DATABASE_URL unset -- src/db.py defaults to a local SQLite file.

# Local Postgres (docker-compose up):
# DATABASE_URL=postgresql+psycopg2://nfl_predict:nfl_predict_dev@localhost:5432/nfl_predict

# Hosted Postgres once live 2026 automation begins (example: Neon):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-example.neon.tech/nfl_predict?sslmode=require

# Odds API key -- only needed once you move past nflverse's free
# consensus lines to a paid live-odds provider. Not required for Phase 1.
# ODDS_API_KEY=

MLFLOW_TRACKING_URI=./mlruns
